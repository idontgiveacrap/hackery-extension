{
  "templates": [
    {
      "id": "decode-basic-auth",
      "name": "Decode Basic Auth",
      "description": "Detect Basic credentials in Authorization / Proxy-Authorization headers and user:pass@ URL userinfo. Logs decoded username and password without changing the request.",
      "rule": {
        "name": "Decode Basic Auth",
        "enabled": true,
        "priority": 50,
        "pageUrlPattern": "",
        "requestUrlPattern": "",
        "requestContentTypePattern": "",
        "requestBodyPattern": "",
        "methods": [],
        "resourceTypes": [],
        "phases": ["request"],
        "responseStatusMin": null,
        "responseStatusMax": null,
        "action": "modify",
        "redirectUrl": "",
        "modify": {
          "urlReplacements": [],
          "bodyReplacements": [],
          "headerReplacements": [],
          "setHeaders": [],
          "requestScript": "function(ctx, rule, decodeBasicAuth) {\n  var creds = decodeBasicAuth(ctx);\n  if (!creds || !creds.length) return ctx;\n  ctx.logDetail = creds.map(function(c) {\n    return c.source + \": \" + c.username + \":\" + c.password;\n  }).join(\"; \");\n  return ctx;\n}",
          "responseScript": "",
          "serveWithoutRequest": false,
          "mockStatus": 200,
          "mockStatusText": "OK",
          "mockBody": ""
        }
      }
    },
    {
      "id": "user-agent-switcher",
      "name": "User-Agent Switcher",
      "description": "Rewrite the User-Agent request header on matching traffic. Edit setHeaders to the string you want. Applies to navigations/subresources via webRequest and to fetch/XHR via the privileged-header rewrite. Does not spoof navigator.userAgent or Client Hints in page JS.",
      "rule": {
        "name": "User-Agent Switcher",
        "enabled": true,
        "priority": 50,
        "pageUrlPattern": "",
        "requestUrlPattern": "",
        "requestContentTypePattern": "",
        "requestBodyPattern": "",
        "methods": [],
        "resourceTypes": [],
        "phases": ["request"],
        "responseStatusMin": null,
        "responseStatusMax": null,
        "action": "modify",
        "redirectUrl": "",
        "modify": {
          "urlReplacements": [],
          "bodyReplacements": [],
          "headerReplacements": [],
          "setHeaders": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1"
            }
          ],
          "requestScript": "",
          "responseScript": "",
          "serveWithoutRequest": false,
          "mockStatus": 200,
          "mockStatusText": "OK",
          "mockBody": ""
        }
      }
    },
    {
      "id": "disable-csp",
      "name": "Disable CSP",
      "description": "Omit Content-Security-Policy on matching documents while network rules are armed. Timer-gated. Isolation headers are left alone unless another rule removes them. Hard-reload after arming.",
      "rule": {
        "name": "Disable CSP",
        "enabled": true,
        "priority": 10,
        "pageUrlPattern": "",
        "requestUrlPattern": "",
        "requestContentTypePattern": "",
        "requestBodyPattern": "",
        "methods": [],
        "resourceTypes": ["main_frame", "sub_frame"],
        "phases": ["response"],
        "responseStatusMin": null,
        "responseStatusMax": null,
        "action": "modify",
        "redirectUrl": "",
        "modify": {
          "urlReplacements": [],
          "bodyReplacements": [],
          "headerReplacements": [],
          "setHeaders": [
            {
              "name": "Content-Security-Policy",
              "value": ""
            }
          ],
          "requestScript": "",
          "responseScript": "",
          "serveWithoutRequest": false,
          "mockStatus": 200,
          "mockStatusText": "OK",
          "mockBody": "",
          "cspSeed": "empty",
          "cspMode": "disable"
        }
      }
    },
    {
      "id": "csp-only-self",
      "name": "CSP only 'self'",
      "description": "Replace site CSP with default-src 'self'; script-src 'self'. The engine adds a nonce when composing. Breaks third-party scripts, connect, and frames. Timer-gated. Hard-reload after arming.",
      "rule": {
        "name": "CSP only self",
        "enabled": true,
        "priority": 20,
        "pageUrlPattern": "",
        "requestUrlPattern": "",
        "requestContentTypePattern": "",
        "requestBodyPattern": "",
        "methods": [],
        "resourceTypes": ["main_frame", "sub_frame"],
        "phases": ["response"],
        "responseStatusMin": null,
        "responseStatusMax": null,
        "action": "modify",
        "redirectUrl": "",
        "modify": {
          "urlReplacements": [],
          "bodyReplacements": [],
          "headerReplacements": [],
          "setHeaders": [
            {
              "name": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self'"
            }
          ],
          "requestScript": "",
          "responseScript": "",
          "serveWithoutRequest": false,
          "mockStatus": 200,
          "mockStatusText": "OK",
          "mockBody": "",
          "cspSeed": "empty",
          "cspMode": ""
        }
      }
    },
    {
      "id": "csp-patch-script-src",
      "name": "Patch CSP script-src",
      "description": "Seed the site’s CSP and replace a script-src token. Edit find/replace for the page. Timer-gated. Site+nonce without other mutations is the sidebar Nonce toggle, not this template.",
      "rule": {
        "name": "Patch CSP script-src",
        "enabled": true,
        "priority": 40,
        "pageUrlPattern": "",
        "requestUrlPattern": "",
        "requestContentTypePattern": "",
        "requestBodyPattern": "",
        "methods": [],
        "resourceTypes": ["main_frame", "sub_frame"],
        "phases": ["response"],
        "responseStatusMin": null,
        "responseStatusMax": null,
        "action": "modify",
        "redirectUrl": "",
        "modify": {
          "urlReplacements": [],
          "bodyReplacements": [],
          "headerReplacements": [
            {
              "name": "Content-Security-Policy",
              "find": "script-src 'self'",
              "replace": "script-src 'self' https://cdn.example",
              "isRegex": false
            }
          ],
          "setHeaders": [],
          "requestScript": "",
          "responseScript": "",
          "serveWithoutRequest": false,
          "mockStatus": 200,
          "mockStatusText": "OK",
          "mockBody": "",
          "cspSeed": "original",
          "cspMode": ""
        }
      }
    }
  ]
}
